<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Animoon"
        android:appCategory="game">

        <!-- SPLASH -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- MENU PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- REGISTRO -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.AvatarSelectionActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.VerificationActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- LOGIN -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />

        <!-- MENÚ DE MINIJUEGOS -->
        <activity
            android:name=".ui.minigame.MinigamesActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- RESULTADOS MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1ResultActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- CINEMÁTICA MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1CinematicActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />

        <!-- MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1Activity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- MINIJUEGO 2 -->
        <activity
            android:name=".ui.minigame.game2.Game2Activity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

    </application>

</manifest>