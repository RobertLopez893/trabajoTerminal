<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/animoon_background"
    android:padding="@dimen/animoon_screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:accessibilityHeading="true"
            android:text="Panel para padres y tutores"
            android:textAppearance="@style/TextAppearance.Animoon.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParentExit"
            style="@style/Widget.Animoon.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir del panel" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="DEMOSTRACIÓN · La cuenta y las alertas son ficticias."
        android:textColor="#655879"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:layout_marginEnd="18dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="14dp"
                    android:src="@drawable/logo_animoon"
                    android:scaleType="fitCenter"
                    android:contentDescription="ANIMOON" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Animoon.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/animoon_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CUENTA SUPERVISADA"
                            android:textColor="#7951B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtParentChildName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:id="@+id/txtParentChildDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Consulta las alertas para conocer el contexto de cada situación."
                            android:lineSpacingExtra="4dp"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Animoon.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/animoon_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Un espacio de consulta"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="El historial es de solo lectura. Al salir del panel se solicitará una nueva verificación para volver a entrar."
                            android:lineSpacingExtra="4dp"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnParentGeneralGuidance"
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:minHeight="56dp"
                            android:text="Consejos para acompañar" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Animoon.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.68">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/animoon_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="Historial de alertas"
                    android:textAppearance="@style/TextAppearance.Animoon.Section" />

                <TextView
                    android:id="@+id/txtParentAlertCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                <TextView
                    android:id="@+id/txtParentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="No se han registrado alertas de seguridad."
                    android:textAppearance="@style/TextAppearance.Animoon.BodySecondary"
                    android:visibility="gone" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/containerParentAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>