<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Animoon.Title"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/animoon_title_size</item>
        <item name="android:textColor">@color/animoon_text_primary</item>
    </style>

    <style name="TextAppearance.Animoon.Section"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/animoon_section_size</item>
        <item name="android:textColor">@color/animoon_text_primary</item>
    </style>

    <style name="TextAppearance.Animoon.Body"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/animoon_body_size</item>
        <item name="android:textColor">@color/animoon_text_primary</item>
    </style>

    <style name="TextAppearance.Animoon.BodySecondary"
        parent="TextAppearance.Animoon.Body">
        <item name="android:textColor">@color/animoon_text_secondary</item>
    </style>

    <style name="Widget.Animoon.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/animoon_button_min_height</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/animoon_button_text_size</item>
        <item name="android:textColor">@color/animoon_button_primary_text</item>
        <item name="backgroundTint">@color/animoon_button_primary</item>
        <item name="cornerRadius">@dimen/animoon_button_radius</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <style name="Widget.Animoon.Button.Secondary"
        parent="Widget.Animoon.Button.Primary">
        <item name="android:textColor">@color/animoon_text_primary</item>
        <item name="backgroundTint">@color/animoon_button_secondary</item>
        <item name="strokeColor">@color/animoon_border_strong</item>
        <item name="strokeWidth">@dimen/animoon_border_width</item>
    </style>

    <style name="Widget.Animoon.Card"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/animoon_surface</item>
        <item name="cardCornerRadius">@dimen/animoon_card_radius</item>
        <item name="cardElevation">@dimen/animoon_card_elevation</item>
        <item name="strokeColor">@color/animoon_border</item>
        <item name="strokeWidth">@dimen/animoon_border_width</item>
    </style>

    <style name="Widget.Animoon.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- Mantiene la variante oscura de los formularios -->
    <style name="ThemeOverlay.Animoon.Auth"
        parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorPrimary">@color/animoon_auth_primary</item>
        <item name="colorOnPrimary">@color/animoon_auth_text</item>
        <item name="colorSurface">@color/animoon_auth_surface</item>
        <item name="colorOnSurface">@color/animoon_auth_text</item>
        <item name="android:textColorPrimary">@color/animoon_auth_text</item>
        <item name="android:textColorSecondary">@color/animoon_auth_text_secondary</item>
        <item name="android:colorBackground">@color/animoon_auth_background</item>
    </style>
</resources>