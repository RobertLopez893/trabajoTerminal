<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FAFFFFFF"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp"
    app:strokeColor="#D8DDF5"
    app:strokeWidth="2dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="36dp"
        android:paddingTop="34dp"
        android:paddingEnd="36dp"
        android:paddingBottom="34dp">


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtPauseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juego pausado"
            android:textColor="#29345C"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />


        <!-- MENSAJE -->

        <TextView
            android:id="@+id/txtPauseMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¿Qué quieres hacer?"
            android:textColor="#67729B"
            android:textSize="18sp"
            android:gravity="center" />


        <!-- CONTINUAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPauseContinue"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="#6674D9"
            app:cornerRadius="22dp" />


        <!-- SALIR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPauseExit"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:text="Salir"
            android:textAllCaps="false"
            android:textColor="#29345C"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="#E8EBFA"
            app:cornerRadius="22dp"
            app:strokeColor="#BCC5EC"
            app:strokeWidth="2dp" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>