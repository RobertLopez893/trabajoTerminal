<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ===================================================== -->
    <!-- FONDO DEL LOBBY                                       -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/ivLobbyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/lobby_base_principal" />


    <!-- ===================================================== -->
    <!-- CAPA DEL MUNDO                                        -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/worldLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
            HOTSPOT DEL CENTRO DE ENTRENAMIENTO

            De momento dejamos el color semitransparente
            para poder ubicar correctamente el área.

            Cuando terminemos el punto del hotspot,
            lo haremos completamente transparente.
        -->

        <View
            android:id="@+id/hotspotMinigames"

            android:layout_width="0dp"
            android:layout_height="0dp"

            android:background="@drawable/bg_hotspot_portal"

            android:clickable="true"
            android:focusable="true"

            android:contentDescription="Entrar al Centro de Entrenamiento"

            app:layout_constraintWidth_percent="0.20"
            app:layout_constraintHeight_percent="0.30"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintHorizontal_bias="0.50"
            app:layout_constraintVertical_bias="0.31" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- CAPA DEL HUD                                          -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hudLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!-- ================================================= -->
        <!-- USUARIOS ACTIVOS                                  -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUsers"
            android:layout_width="wrap_content"
            android:layout_height="56dp"

            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"

            android:minWidth="130dp"

            android:text="Usuarios"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"

            android:maxLines="1"
            android:singleLine="true"

            app:backgroundTint="#DD292241"
            app:cornerRadius="28dp"
            app:strokeColor="#887B70A5"
            app:strokeWidth="1dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ================================================= -->
        <!-- CERRAR SESIÓN                                     -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="56dp"

            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"

            android:minWidth="150dp"

            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"

            android:maxLines="1"
            android:singleLine="true"

            app:backgroundTint="#DD292241"
            app:cornerRadius="28dp"
            app:strokeColor="#887B70A5"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ================================================= -->
        <!-- NOMBRE DE LA ZONA                                 -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoneName"
            android:layout_width="wrap_content"
            android:layout_height="56dp"

            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"

            android:clickable="false"
            android:focusable="false"

            android:minWidth="180dp"

            android:text="📍 Base Principal"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"

            android:maxLines="1"
            android:singleLine="true"

            app:backgroundTint="#DD292241"
            app:cornerRadius="28dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- ================================================= -->
        <!-- MENÚ GENERAL DE MINIJUEGOS                        -->
        <!-- ================================================= -->
        <!--
            Este botón NO abre directamente el Minijuego 1.

            Posteriormente llevará a una pantalla donde estarán
            disponibles todos los minijuegos de ANIMOON.
        -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinigames"
            android:layout_width="210dp"
            android:layout_height="64dp"

            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"

            android:text="🎮  Minijuegos"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"

            android:maxLines="1"
            android:singleLine="true"

            app:backgroundTint="#E43E3268"
            app:cornerRadius="32dp"
            app:strokeColor="#AA8C7BD1"
            app:strokeWidth="2dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>