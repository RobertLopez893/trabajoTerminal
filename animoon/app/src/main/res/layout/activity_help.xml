<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/animoon_background"
    android:padding="@dimen/animoon_screen_padding">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHelpBack"
        style="@style/Widget.Animoon.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regresar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtHelpTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/animoon_space_large"
        android:text="Ayuda"
        android:textAppearance="@style/TextAppearance.Animoon.Title"
        app:layout_constraintStart_toEndOf="@id/btnHelpBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnHelpBack"
        app:layout_constraintBottom_toBottomOf="@id/btnHelpBack" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHelp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/animoon_space_medium"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/animoon_space_small"
        app:layout_constraintWidth_max="760dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHelpBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/animoon_space_small">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/animoon_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¡Exploremos ANIMOON!"
                        android:textAppearance="@style/TextAppearance.Animoon.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/animoon_space_small"
                        android:lineSpacingExtra="4dp"
                        android:text="Aquí puedes aprender a usar ANIMOON y encontrar consejos para cuidarte en Internet. Toca una pregunta para ver su respuesta."
                        android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/animoon_space_large"
                android:layout_marginBottom="@dimen/animoon_space_small"
                android:accessibilityHeading="true"
                android:text="Cómo jugar"
                android:textAppearance="@style/TextAppearance.Animoon.Section" />

            <LinearLayout
                android:id="@+id/containerHelpInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/animoon_space_large"
                android:layout_marginBottom="@dimen/animoon_space_small"
                android:accessibilityHeading="true"
                android:text="Cuídate en Internet"
                android:textAppearance="@style/TextAppearance.Animoon.Section" />

            <LinearLayout
                android:id="@+id/containerHelpSafety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/animoon_space_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/animoon_card_padding"
                    android:lineSpacingExtra="4dp"
                    android:text="Recuerda: si algo te preocupa, puedes pedir ayuda. No es tu culpa que otra persona te presione o te haga sentir mal."
                    android:textAppearance="@style/TextAppearance.Animoon.Body" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>