<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/animoon_background"
    android:padding="@dimen/animoon_screen_padding">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfileBack"
        style="@style/Widget.Animoon.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regresar"
        app:icon="@drawable/ic_animoon_back"
        app:iconTint="@color/animoon_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtProfileTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/animoon_space_large"
        android:text="Perfil"
        android:textAppearance="@style/TextAppearance.Animoon.Title"
        app:layout_constraintStart_toEndOf="@id/btnProfileBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnProfileBack"
        app:layout_constraintBottom_toBottomOf="@id/btnProfileBack" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/animoon_space_medium"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintWidth_max="820dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnProfileBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/animoon_space_small">

            <TextView
                android:id="@+id/txtProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No encontramos este perfil."
                android:textAppearance="@style/TextAppearance.Animoon.Body"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                style="@style/Widget.Animoon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="@dimen/animoon_card_padding">

                    <!-- COLUMNA IZQUIERDA: AVATAR Y APELATIVO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/imgProfileAvatar"
                            android:layout_width="160dp"
                            android:layout_height="180dp"
                            android:contentDescription="Avatar del jugador"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/txtProfileAvatarUnavailable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Avatar no disponible"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/animoon_space_small"
                            android:gravity="center"
                            android:text="Apelativo"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <TextView
                            android:id="@+id/txtProfileNickname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Animoon.Title" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfileChat"
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/animoon_space_medium"
                            android:text="Chatear"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- DIVISOR VERTICAL -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/animoon_border" />

                    <!-- COLUMNA DERECHA: ESTADÍSTICAS DE MINIJUEGOS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estadísticas de minijuegos"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp"
                            android:text="Récords y avances conseguidos"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <!-- MINIJUEGO 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_moonie_message"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Repara a Moonie"
                                android:scaleType="fitCenter"
                                android:src="@drawable/moonie_damaged" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtGame1Name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Repara a Moonie"
                                    android:textAppearance="@style/TextAppearance.Animoon.Body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtGame1Stats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Récord: 0 pts"
                                    android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- MINIJUEGO 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_moonie_message"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Reconecta a Moonie"
                                android:scaleType="fitCenter"
                                android:src="@drawable/moonie_neutral" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtGame2Name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Reconecta a Moonie"
                                    android:textAppearance="@style/TextAppearance.Animoon.Body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtGame2Stats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Récord: 0 pts"
                                    android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- MINIJUEGO 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_moonie_message"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Los oídos de Moonie"
                                android:scaleType="fitCenter"
                                android:src="@drawable/moonie_confused" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtGame3Name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Los oídos de Moonie"
                                    android:textAppearance="@style/TextAppearance.Animoon.Body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtGame3Stats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Récord: 0 pts"
                                    android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
