<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Animoon.Card"
    android:layout_width="520dp"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/animoon_card_padding">

            <ImageView
                android:id="@+id/imgDialogMoonie"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:contentDescription="@string/animoon_moonie"
                android:scaleType="fitCenter"
                android:src="@drawable/moonie_neutral" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Centro de Entrenamiento"
                android:textAppearance="@style/TextAppearance.Animoon.Title" />

            <TextView
                android:id="@+id/tvDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="¿Quieres entrar y ayudar a Moonie?"
                android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

            <TextView
                android:id="@+id/tvDialogSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="¡Tu entrenamiento de seguridad digital te espera!"
                android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnter"
                style="@style/Widget.Animoon.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Entrar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStay"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Quedarme aquí" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>