<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cinematicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagen principal -->
    <ImageView
        android:id="@+id/ivCinematic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Escena de la historia"
        android:scaleType="centerCrop" />

    <!-- Botón para saltar -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_cinematic_skip"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="Saltar"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Cuadro narrativo -->
    <LinearLayout
        android:id="@+id/storyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_cinematic_dialog"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="18dp"
        android:paddingEnd="30dp"
        android:paddingBottom="18dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvSceneTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFE56B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Narración -->
        <TextView
            android:id="@+id/tvStory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="@android:color/white"
            android:textSize="19sp" />

        <!-- Parte inferior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Indicadores -->
            <LinearLayout
                android:id="@+id/sceneIndicators"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />

            <!-- Botón siguiente -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:background="@drawable/bg_cinematic_button"
                android:minWidth="180dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="SIGUIENTE"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>