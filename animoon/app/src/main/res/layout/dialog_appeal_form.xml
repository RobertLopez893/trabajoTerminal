<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Animoon.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/animoon_border_strong"
    app:strokeWidth="2dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvAppealFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Crees que se trata de un error?"
                android:textAppearance="@style/TextAppearance.Animoon.Title"
                android:textColor="@color/animoon_text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvAppealFormSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="Redacta una breve justificación explicando por qué consideras que la suspensión fue un error. Un administrador revisará manualmente tu caso."
                android:textAppearance="@style/TextAppearance.Animoon.BodySecondary"
                android:textColor="@color/animoon_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAppealAccountBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/animoon_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Cuenta: @CometaAzul" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAppealNickname"
                style="@style/Widget.Animoon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Apelativo de tu cuenta"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAppealNickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/animoon_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAppealJustification"
                style="@style/Widget.Animoon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Justificación (máx. 250 caracteres)"
                app:counterEnabled="true"
                app:counterMaxLength="250"
                app:counterTextColor="@color/animoon_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAppealJustification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="250"
                    android:minLines="4"
                    android:maxLines="6"
                    android:textColor="@color/animoon_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/pbAppealLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAppeal"
                style="@style/Widget.Animoon.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Enviar solicitud de apelación" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelAppeal"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
