<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ===================================================== -->
    <!-- FONDO                                                 -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgIntroBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Fondo de introducción"
        android:scaleType="centerCrop"
        android:src="@drawable/game1_bg_base_principal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Capa ligera para mejorar legibilidad -->

    <View
        android:id="@+id/introOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#18000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- PROGRESO                                              -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtIntroProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_score"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="1 de 3"
        android:textColor="#29345C"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ===================================================== -->
    <!-- MOONIE                                                -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgIntroMoonie"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="30dp"
        android:contentDescription="Moonie"
        android:scaleType="fitCenter"
        android:src="@drawable/moonie_very_damaged"
        app:layout_constraintWidth_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- ===================================================== -->
    <!-- TARJETA NARRATIVA                                     -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIntroStory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="44dp"
        app:cardBackgroundColor="#F7FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp"
        app:strokeColor="#D8DDF5"
        app:strokeWidth="2dp"
        app:layout_constraintStart_toEndOf="@id/imgIntroMoonie"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="38dp"
            android:paddingTop="34dp"
            android:paddingEnd="38dp"
            android:paddingBottom="30dp">


            <!-- TÍTULO -->

            <TextView
                android:id="@+id/txtIntroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="¡Oh no!"
                android:textColor="#29345C"
                android:textSize="34sp"
                android:textStyle="bold" />


            <!-- MENSAJE -->

            <TextView
                android:id="@+id/txtIntroMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="¡Hola! Soy Moonie. Algo salió mal con mi sistema de seguridad y necesito tu ayuda."
                android:textColor="#39456E"
                android:textSize="21sp" />


            <!-- ESPACIO ENTRE TEXTO Y BOTONES -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />


            <!-- BOTONES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">


                <!-- ANTERIOR -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIntroBack"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="Anterior"
                    android:textAllCaps="false"
                    android:textColor="#29345C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    app:backgroundTint="#E8EBFA"
                    app:cornerRadius="22dp"
                    app:strokeColor="#BCC5EC"
                    app:strokeWidth="2dp" />


                <!-- SIGUIENTE / COMENZAR -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIntroNext"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Siguiente"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="#6674D9"
                    app:cornerRadius="22dp" />


            </LinearLayout>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>