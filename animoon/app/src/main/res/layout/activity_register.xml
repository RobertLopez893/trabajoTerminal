<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth_forms" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44302644"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/registerScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Identidad y progreso -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.36"
                android:orientation="vertical"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:contentDescription="ANIMOON"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_animoon" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFF9FF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#CFBFEA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tu aventura comienza aquí"
                            android:textColor="#302644"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/AnimoonRegistrationStepActive"
                            android:layout_marginTop="16dp"
                            android:text="1 · Datos de la cuenta"
                            android:contentDescription="Paso 1, datos de la cuenta, actual" />

                        <TextView
                            style="@style/AnimoonRegistrationStep"
                            android:layout_marginTop="6dp"
                            android:text="2 · Código SMS" />

                        <TextView
                            style="@style/AnimoonRegistrationStep"
                            android:layout_marginTop="6dp"
                            android:text="3 · Elige tu avatar" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Realiza el registro con ayuda de tu mamá, papá o tutor."
                            android:textColor="#655879"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Formulario -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.64"
                app:cardBackgroundColor="#FFF9FF"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeColor="#CFBFEA"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASO 1 DE 3"
                        android:textColor="#7951B0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityHeading="true"
                        android:text="Crea tu cuenta"
                        android:textColor="#302644"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Elige cómo te conocerán en ANIMOON."
                        android:textColor="#655879"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AnimoonRegistrationInput"
                        android:hint="Apelativo del niño"
                        app:helperText="Elige un apodo; evita utilizar tu nombre completo.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterApelativo"
                            style="@style/AnimoonRegistrationEditText"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:autofillHints="newUsername" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AnimoonRegistrationInput"
                        android:hint="Teléfono del tutor"
                        app:prefixText="+52 "
                        app:helperText="Enviaremos un código por SMS a este número.">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTutorPhone"
                            style="@style/AnimoonRegistrationEditText"
                            android:inputType="phone"
                            android:digits="0123456789"
                            android:maxLength="10"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AnimoonRegistrationInput"
                        android:hint="Contraseña"
                        app:helperText="Utiliza al menos 8 caracteres."
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterPassword"
                            style="@style/AnimoonRegistrationEditText"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:autofillHints="newPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AnimoonRegistrationInput"
                        android:hint="Confirmar contraseña"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            style="@style/AnimoonRegistrationEditText"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:autofillHints="newPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/checkTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:buttonTint="#7951B0"
                        android:text="El tutor acepta los lineamientos de privacidad y uso de datos."
                        android:textColor="#493D5C"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendSms"
                        style="@style/Widget.Animoon.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="56dp"
                        android:enabled="false"
                        android:text="Enviar código SMS" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/Widget.Animoon.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="Volver al inicio de sesión" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>