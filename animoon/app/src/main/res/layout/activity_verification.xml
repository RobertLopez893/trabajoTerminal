<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth_forms" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44302644"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Identidad y progreso -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.36"
                android:orientation="vertical"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:contentDescription="ANIMOON"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_animoon" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFF9FF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#CFBFEA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Un paso más"
                            android:textColor="#302644"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/AnimoonRegistrationStep"
                            android:layout_marginTop="16dp"
                            android:text="✓ · Datos de la cuenta"
                            android:textColor="#286A59"
                            android:contentDescription="Paso 1, datos de la cuenta, completado" />

                        <TextView
                            style="@style/AnimoonRegistrationStepActive"
                            android:layout_marginTop="6dp"
                            android:text="2 · Código SMS"
                            android:contentDescription="Paso 2, código SMS, actual" />

                        <TextView
                            style="@style/AnimoonRegistrationStep"
                            android:layout_marginTop="6dp"
                            android:text="3 · Elige tu avatar" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Pide ayuda a tu tutor para consultar el mensaje recibido."
                            android:textColor="#655879"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Captura del código -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.64"
                app:cardBackgroundColor="#FFF9FF"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeColor="#CFBFEA"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASO 2 DE 3"
                        android:textColor="#7951B0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityHeading="true"
                        android:text="Ingresa el código"
                        android:textColor="#302644"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Enviamos un SMS al teléfono de tu tutor:"
                        android:textColor="#655879"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Teléfono del tutor"
                        android:textColor="#624393"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Escribe los 6 números del mensaje."
                        android:textColor="#655879"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/codeContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtCode1"
                            style="@style/AnimoonVerificationDigit"
                            android:contentDescription="Dígito 1 del código" />

                        <EditText
                            android:id="@+id/edtCode2"
                            style="@style/AnimoonVerificationDigit"
                            android:contentDescription="Dígito 2 del código" />

                        <EditText
                            android:id="@+id/edtCode3"
                            style="@style/AnimoonVerificationDigit"
                            android:contentDescription="Dígito 3 del código" />

                        <EditText
                            android:id="@+id/edtCode4"
                            style="@style/AnimoonVerificationDigit"
                            android:contentDescription="Dígito 4 del código" />

                        <EditText
                            android:id="@+id/edtCode5"
                            style="@style/AnimoonVerificationDigit"
                            android:contentDescription="Dígito 5 del código" />

                        <EditText
                            android:id="@+id/edtCode6"
                            style="@style/AnimoonVerificationDigit"
                            android:imeOptions="actionDone"
                            android:contentDescription="Dígito 6 del código" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtResend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:text="Reenviar código en 02:00"
                        android:textColor="#624393"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerify"
                        style="@style/Widget.Animoon.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="56dp"
                        android:text="Continuar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBack"
                        style="@style/Widget.Animoon.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="Volver a mis datos" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>