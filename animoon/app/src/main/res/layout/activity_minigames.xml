<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/animoon_screen_padding"
    android:background="@drawable/bg_minigames_menu">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackMinigames"
            style="@style/Widget.Animoon.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/animoon_back"
            app:icon="@drawable/ic_animoon_back"
            app:iconTint="@color/animoon_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMinigamesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minijuegos"
                android:textAppearance="@style/TextAppearance.Animoon.Title" />

            <TextView
                android:id="@+id/txtMinigamesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elige una misión y comienza tu entrenamiento"
                android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

        </LinearLayout>
    </LinearLayout>

    <!-- DESPLAZAMIENTO HORIZONTAL -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- MINIJUEGO 1 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_moonie_message"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/animoon_available"
                            android:textColor="@color/animoon_success"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/animoon_menu_image_size"
                            android:layout_height="@dimen/animoon_menu_image_size"
                            android:layout_marginTop="8dp"
                            android:contentDescription="Moonie averiado"
                            android:scaleType="fitCenter"
                            android:src="@drawable/moonie_damaged" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Repara a Moonie"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="Pon a prueba lo que sabes sobre seguridad digital y ayuda a Moonie a recuperarse."
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGame1"
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/animoon_play" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- MINIJUEGO 2 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_moonie_message"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/animoon_available"
                            android:textColor="@color/animoon_success"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/animoon_menu_image_size"
                            android:layout_height="@dimen/animoon_menu_image_size"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/animoon_moonie"
                            android:scaleType="fitCenter"
                            android:src="@drawable/moonie_neutral" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/animoon_game2_title"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/animoon_game2_description"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGame2"
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/animoon_play" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- MINIJUEGO 3 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/animoon_surface_disabled">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/animoon_border_strong"
                            android:textSize="74sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Minijuego 3"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Próximamente"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:enabled="false"
                            android:text="Próximamente" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- MINIJUEGO 4 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Animoon.Card"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/animoon_surface_disabled">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textColor="@color/animoon_border_strong"
                            android:textSize="74sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Minijuego 4"
                            android:textAppearance="@style/TextAppearance.Animoon.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Próximamente"
                            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Animoon.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:enabled="false"
                            android:text="Próximamente" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>