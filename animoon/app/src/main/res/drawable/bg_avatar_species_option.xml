<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8DCFA" />
            <stroke
                android:width="3dp"
                android:color="#7550A4" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEE5FA" />
            <stroke
                android:width="2dp"
                android:color="#A58AC7" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5EFFF" />
            <stroke
                android:width="2dp"
                android:color="#7550A4" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F3FF" />
            <stroke
                android:width="1dp"
                android:color="#D8C9EB" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</selector>