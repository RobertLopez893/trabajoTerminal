<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Animoon"
        android:appCategory="game">

        <!-- SPLASH (Punto de entrada principal) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- MENU PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />
        <activity
            android:name=".ui.world.CratersActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.world.VillageActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.world.DarkSideActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- REGISTRO -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.PrivacyNoticeActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.AvatarSelectionActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.VerificationActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- LOGIN -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- ADMINISTRACIÓN DE APELACIONES -->
        <activity
            android:name=".ui.admin.AdminAppealsActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- AJUSTES -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- AYUDA -->
        <activity
            android:name=".ui.help.HelpActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- VERIFICACIÓN PARA PADRES -->
        <activity
            android:name=".ui.parents.ParentVerificationActivity"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- PANEL PARA PADRES -->
        <activity
            android:name=".ui.parents.ParentDashboardActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- DETALLE DE INCIDENCIA PARA PADRES -->
        <activity
            android:name=".ui.parents.ParentIncidentDetailActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- PERFILES -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- MENÚ DE MINIJUEGOS -->
        <activity
            android:name=".ui.minigame.MinigamesActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- RESULTADOS MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1ResultActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- CINEMÁTICA MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1CinematicActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true" />

        <!-- MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.game1.Game1Activity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <!-- MINIJUEGO 2 -->
        <activity
            android:name=".ui.minigame.game2.Game2CinematicActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.minigame.game2.Game2Activity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.minigame.game2.Game2ResultActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- MINIJUEGO 3 -->
        <activity
            android:name=".ui.minigame.game3.Game3CinematicActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.minigame.game3.Game3Activity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.minigame.game3.Game3ResultActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- CHAT -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

    </application>

</manifest>
