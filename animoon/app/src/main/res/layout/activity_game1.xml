<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONDO DEL MINIJUEGO                                       -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Fondo de la Base Principal"
        android:scaleType="centerCrop"
        android:src="@drawable/game1_bg_base_principal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/backgroundOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#16000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- BARRA SUPERIOR                                            -->

    <ImageButton
        android:id="@+id/btnPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_game_circle_button"
        android:contentDescription="Pausar juego"
        android:padding="16dp"
        android:src="@android:drawable/ic_media_pause"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/txtProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta 1 de 10"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnPause"
        app:layout_constraintBottom_toBottomOf="@id/btnPause" />


    <!-- ÁREA DE MOONIE                                            -->

    <TextView
        android:id="@+id/txtScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_score"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="★ 0 puntos"
        android:textColor="#29345C"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/moonieContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintWidth_percent="0.34"
        app:layout_constraintTop_toBottomOf="@id/btnPause"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgMoonie"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:contentDescription="Moonie"
            android:scaleType="fitCenter"
            android:src="@drawable/moonie_neutral"
            app:layout_constraintWidth_percent="0.82"
            app:layout_constraintHeight_percent="0.68"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtMoonieMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_moonie_message"
            android:gravity="center"
            android:padding="18dp"
            android:text="¡Ayúdame a recuperar mi entrenamiento!"
            android:textColor="#29345C"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imgMoonie"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ÁREA DE PREGUNTA                                          -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/questionContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@id/moonieContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPause"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- TARJETA DE PREGUNTA -->

        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_question_card"
            android:gravity="center"
            android:padding="28dp"
            android:text="Si alguien que conocí por Internet me pide la dirección de mi escuela debo..."
            android:textColor="#29345C"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.32"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- RESPUESTA A -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnswer1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:maxLines="2"
            android:minHeight="68dp"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:text="No compartirla"
            android:textAllCaps="false"
            android:textColor="#29345C"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="#F2FFFFFF"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtQuestion"
            app:strokeColor="#CFD8F5"
            app:strokeWidth="2dp" />

        <!-- RESPUESTA B -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnswer2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:maxLines="2"
            android:text="Compartirla"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#29345C"
            app:backgroundTint="#F2FFFFFF"
            app:cornerRadius="24dp"
            app:strokeColor="#CFD8F5"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toBottomOf="@id/btnAnswer1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- RESPUESTA C -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnswer3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:maxLines="2"
            android:text="Inventar otra dirección"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#29345C"
            app:backgroundTint="#F2FFFFFF"
            app:cornerRadius="24dp"
            app:strokeColor="#CFD8F5"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toBottomOf="@id/btnAnswer2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>