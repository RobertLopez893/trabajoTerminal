<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Animoon.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/animoon_border_strong"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgInviteAvatar"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="Avatar del jugador"
            android:scaleType="fitCenter"
            android:src="@drawable/avatar_fox_orange" />

        <TextView
            android:id="@+id/tvInviteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="💬 ¡Mensaje de Chat!"
            android:textAppearance="@style/TextAppearance.Animoon.Title"
            android:textColor="@color/animoon_text_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvInviteMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary"
            android:textColor="@color/animoon_text_secondary"
            android:textSize="15sp"
            android:text="¡El jugador te ha enviado un mensaje y quiere chatear contigo en la sala segura!" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectChat"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textColor="@color/animoon_text_secondary"
                app:strokeColor="@color/animoon_border_strong"
                android:text="Rechazar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptChat"
                style="@style/Widget.Animoon.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:layout_marginStart="8dp"
                android:text="¡Aceptar!" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
