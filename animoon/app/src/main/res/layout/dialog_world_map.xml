<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Explora ANIMOON"
            android:textAppearance="@style/TextAppearance.Animoon.Title" />

        <TextView
            android:id="@+id/txtMapCurrentZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Animoon.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca el nombre del lugar al que quieres viajar."
            android:textAppearance="@style/TextAppearance.Animoon.BodySecondary" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- Imagen completa: los botones se posicionan
                 respecto al mismo rectángulo del mapa. -->

            <ImageView
                android:id="@+id/imgWorldMap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/mapa_animoon"
                app:layout_constraintDimensionRatio="H,16:10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Base Principal: cuadrante superior izquierdo -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapBase"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Base Principal"
                android:textSize="14sp"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintStart_toStartOf="@id/imgWorldMap"
                app:layout_constraintEnd_toEndOf="@id/imgWorldMap"
                app:layout_constraintTop_toTopOf="@id/imgWorldMap"
                app:layout_constraintBottom_toBottomOf="@id/imgWorldMap"
                app:layout_constraintHorizontal_bias="0.08"
                app:layout_constraintVertical_bias="0.40" />

            <!-- Cráteres: cuadrante superior derecho -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapCraters"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Cráteres gigantes"
                android:textSize="14sp"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintStart_toStartOf="@id/imgWorldMap"
                app:layout_constraintEnd_toEndOf="@id/imgWorldMap"
                app:layout_constraintTop_toTopOf="@id/imgWorldMap"
                app:layout_constraintBottom_toBottomOf="@id/imgWorldMap"
                app:layout_constraintHorizontal_bias="0.92"
                app:layout_constraintVertical_bias="0.40" />

            <!-- Aldea: cuadrante inferior izquierdo -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapVillage"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Aldea lunática"
                android:textSize="14sp"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintStart_toStartOf="@id/imgWorldMap"
                app:layout_constraintEnd_toEndOf="@id/imgWorldMap"
                app:layout_constraintTop_toTopOf="@id/imgWorldMap"
                app:layout_constraintBottom_toBottomOf="@id/imgWorldMap"
                app:layout_constraintHorizontal_bias="0.08"
                app:layout_constraintVertical_bias="0.90" />

            <!-- Lado oscuro: cuadrante inferior derecho -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapDarkSide"
                style="@style/Widget.Animoon.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="El lado oscuro de la luna"
                android:textSize="14sp"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintStart_toStartOf="@id/imgWorldMap"
                app:layout_constraintEnd_toEndOf="@id/imgWorldMap"
                app:layout_constraintTop_toTopOf="@id/imgWorldMap"
                app:layout_constraintBottom_toBottomOf="@id/imgWorldMap"
                app:layout_constraintHorizontal_bias="0.92"
                app:layout_constraintVertical_bias="0.90" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>