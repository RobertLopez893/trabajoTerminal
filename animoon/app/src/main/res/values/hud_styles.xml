<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Animoon.HudCircle"
        parent="Widget.MaterialComponents.Button">

        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>

        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>

        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:padding">20dp</item>
        <item name="android:gravity">center</item>

        <item name="backgroundTint">@color/hud_button_tint</item>
        <item name="cornerRadius">36dp</item>
        <item name="strokeColor">#C9B6EF</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">#668DEAFF</item>

        <item name="iconSize">32dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@null</item>

        <item name="android:elevation">6dp</item>
    </style>

    <style name="Widget.Animoon.HudPill"
        parent="Widget.MaterialComponents.Button">

        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>

        <item name="backgroundTint">@color/hud_button_tint</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">#C9B6EF</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#668DEAFF</item>

        <item name="android:elevation">4dp</item>
    </style>

    <style name="AnimoonHudCaption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>

        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_hud_caption</item>

        <!-- El botón ya anuncia su nombre a TalkBack. -->
        <item name="android:importantForAccessibility">no</item>
    </style>

</resources>