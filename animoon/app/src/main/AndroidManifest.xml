<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Animoon">

        <!-- SPLASH / PANTALLA DE INICIO -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:screenOrientation="landscape"
            android:exported="false">
        </activity>

        <!-- MENU -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>
        </activity>

        <!-- REGISTRO -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.AvatarSelectionActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <activity
            android:name=".ui.auth.VerificationActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <!-- LOGIN -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="landscape"
            android:exported="true" />

        <!-- MENÚ DE MINIJUEGOS -->
        <activity
            android:name=".ui.minigame.MinigamesActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <!-- RESULTADOS MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.Game1ResultActivity"
            android:screenOrientation="landscape"
            android:exported="false" />

        <!-- INTRODUCCIÓN MINIJUEGO 1 - PRUEBA TEMPORAL -->
        <activity
            android:name=".ui.minigame.Game1CinematicActivity"
            android:screenOrientation="landscape"
            android:exported="true"/>


        <!-- MINIJUEGO 1 -->
        <activity
            android:name=".ui.minigame.Game1Activity"
            android:screenOrientation="landscape"
            android:exported="false" />

    </application>

</manifest>