<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Animoon.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/animoon_space_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/animoon_card_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpQuestion"
            style="@style/Widget.Animoon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:singleLine="false"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/txtHelpAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/animoon_space_medium"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.Animoon.Body"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>